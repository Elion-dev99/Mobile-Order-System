rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Platform kill switch (Ops). Missing doc = not in maintenance.
    function isMaintenance() {
      return exists(/databases/$(database)/documents/platform/config)
        && get(/databases/$(database)/documents/platform/config).data.maintenance == true;
    }

    function isValidOrder() {
      return request.resource.data.keys().hasAll(['id', 'shopId', 'timestamp'])
        && request.resource.data.id is string
        && request.resource.data.shopId is string
        && request.resource.data.timestamp is number
        && request.resource.data.id.size() < 80
        && request.resource.data.shopId.size() < 64;
    }

    function isValidLeadCreate() {
      return request.resource.data.keys().hasAll(['createdAt'])
        && request.resource.data.createdAt is number
        && (!('email' in request.resource.data)
          || request.resource.data.email is string
            && request.resource.data.email.size() < 200);
    }

    // Kitchen / floor tablets: status + payment close without full Auth
    function orderFloorUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'paymentStatus', 'payment', 'paidAt', 'closedAt']);
    }

    // Guest checkout + Store floor tablet: narrow field patches without Firebase Auth.
    function storeFloorShopUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'stock', 'soldOut', 'coupons', 'updatedAt',
          'isOpen',
          'name', 'subtitle', 'hoursNote', 'address', 'tableCount',
          'ownerEmail', 'ownerPhone', 'locale',
          'lastOrderEnabled', 'lastOrderTime',
          'accentColor', 'minOrderAmount', 'partySizeRequired', 'ageGateEnabled',
          'quickServiceEnabled', 'serviceChargePercent', 'tipEnabled',
          'staffPins',
          'channelsEnabled', 'paymentMethodsEnabled',
          'posProvider', 'posLocationId', 'posLastSyncAt',
          'printerMode', 'autoPrintOnOrder', 'printerIp',
          'loyaltyEnabled', 'staffEmails',
        ]);
    }

    match /orders/{id} {
      allow read: if true;
      allow create: if isValidOrder() && !isMaintenance();
      allow update: if orderFloorUpdate() || signedIn();
      allow delete: if signedIn();
    }

    match /shop/{doc} {
      allow read: if true;
      allow create, delete: if signedIn();
      allow update: if signedIn() || storeFloorShopUpdate();
    }

    match /shops/{shopId} {
      allow read: if true;
      allow create, delete: if signedIn();
      allow update: if signedIn() || storeFloorShopUpdate();
    }

    match /shopMenus/{shopId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /leads/{id} {
      allow read, update: if signedIn();
      allow create: if isValidLeadCreate() && !isMaintenance();
      allow delete: if false;
    }

    match /serviceRequests/{id} {
      allow read: if true;
      allow create: if !isMaintenance();
      allow update: if true;
      allow delete: if signedIn();
    }

    match /surveys/{id} {
      allow read: if signedIn();
      allow create: if !isMaintenance();
      allow update, delete: if false;
    }

    match /members/{id} {
      allow read: if true;
      allow create, update: if !isMaintenance();
      allow delete: if signedIn();
    }

    match /reservations/{id} {
      allow read: if true;
      allow create: if !isMaintenance();
      allow update: if true;
      allow delete: if signedIn();
    }

    match /waitlist/{id} {
      allow read: if true;
      allow create: if !isMaintenance();
      allow update: if true;
      allow delete: if signedIn();
    }

    match /auditLogs/{id} {
      allow read: if signedIn();
      allow create: if true;
      allow update, delete: if false;
    }

    // Public platform flags (maintenance). Write = Firebase Auth (Ops/Admin).
    match /platform/{doc} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if signedIn();
    }

    match /ops/{doc} {
      allow read, write: if false;
    }
  }
}
