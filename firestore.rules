rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isValidOrder() {
      return request.resource.data.keys().hasAll(['id', 'shopId', 'timestamp'])
        && request.resource.data.id is string
        && request.resource.data.shopId is string
        && request.resource.data.timestamp is number
        && request.resource.data.id.size() < 80
        && request.resource.data.shopId.size() < 64;
    }

    function isValidLeadCreate() {
      return request.resource.data.keys().hasAll(['createdAt'])
        && request.resource.data.createdAt is number
        && (!('email' in request.resource.data)
          || request.resource.data.email is string
            && request.resource.data.email.size() < 200);
    }

    // Kitchen tablets may advance status without full staff Auth.
    function orderKitchenOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status']);
    }

    // Guest checkout may decrement stock / coupon use; first visit may stamp trial.
    function guestShopOpsUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['stock', 'soldOut', 'coupons', 'updatedAt', 'trialStartedAt', 'trialEndsAt']);
    }

    match /orders/{id} {
      allow read: if true;
      allow create: if isValidOrder();
      allow update: if orderKitchenOnlyUpdate() || signedIn();
      allow delete: if signedIn();
    }

    match /shop/{doc} {
      allow read: if true;
      allow create, delete: if signedIn();
      allow update: if signedIn() || guestShopOpsUpdate();
    }

    match /shops/{shopId} {
      allow read: if true;
      allow create, delete: if signedIn();
      allow update: if signedIn() || guestShopOpsUpdate();
    }

    match /shopMenus/{shopId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Lead PII: public create (LP), staff-only read/update
    match /leads/{id} {
      allow read, update: if signedIn();
      allow create: if isValidLeadCreate();
      allow delete: if false;
    }

    match /serviceRequests/{id} {
      allow read: if true;
      allow create: if true;
      // Store/admin resolve without forcing Auth on every floor tablet
      allow update: if true;
      allow delete: if signedIn();
    }

    match /surveys/{id} {
      allow read: if signedIn();
      allow create: if true;
      allow update, delete: if false;
    }

    match /ops/{doc} {
      allow read, write: if false;
    }
  }
}
